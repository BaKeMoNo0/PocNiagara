# Visual Studio 2015 user specific files
./idea
DarkSwarm/.vs/
DarkSwarm/.idea/
DarkSwarm/.vsconfig

# Compiled Object files
DarkSwarm/*.slo
DarkSwarm/*.lo
DarkSwarm/*.o
DarkSwarm/*.obj

# Precompiled Headers
DarkSwarm/*.gch
DarkSwarm/*.pch

# Compiled Dynamic libraries
DarkSwarm/*.so
DarkSwarm/*.dylib
DarkSwarm/*.dll

# Fortran module files
DarkSwarm/*.mod

# Compiled Static libraries
DarkSwarm/*.lai
DarkSwarm/*.la
DarkSwarm/*.a
DarkSwarm/*.lib

# Executables
DarkSwarm/*.exe
DarkSwarm/*.out
DarkSwarm/*.app
DarkSwarm/*.ipa

# These project files can be generated by the engine
DarkSwarm/*.xcodeproj
DarkSwarm/*.xcworkspace
DarkSwarm/*.sln
DarkSwarm/*.suo
DarkSwarm/*.opensdf
DarkSwarm/*.sdf
DarkSwarm/*.VC.db
DarkSwarm/*.VC.opendb

# Precompiled Assets
DarkSwarm/SourceArt/**/*.png
DarkSwarm/SourceArt/**/*.tga

# Binary Files
DarkSwarm/Binaries/*
DarkSwarm/Plugins/**/Binaries/*

# Builds
DarkSwarm/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
DarkSwarm/!Build/*/
DarkSwarm/Build/*/**
DarkSwarm/!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
DarkSwarm/!Build/**/*.ico

# Built data for maps
DarkSwarm/*_BuiltData.uasset

# Configuration files generated by the Editor
DarkSwarm/Saved/*

# Compiled source files for the engine to use
DarkSwarm/Intermediate/*
DarkSwarm/Plugins/**/Intermediate/*

# Cache files for the editor to use
DarkSwarm/DerivedDataCache/*
